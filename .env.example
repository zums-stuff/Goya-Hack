# PumaTrade — variables de entorno (template)
# ─────────────────────────────────────────────────
# 1. Copia este archivo a `.env.local` y rellena los valores.
# 2. `.env.local` está en .gitignore — NUNCA commitear secrets.
# 3. La fuente de verdad completa vive en ARCHITECTURE.md §14.

# === Pollar — App 1: Usuarios (auth social + email OTP) ===
NEXT_PUBLIC_POLLA_USERS_PUBLISHABLE_KEY=pub_testnet_users_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLLAR_USERS_SECRET_KEY=sec_testnet_users_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Pollar — App 2: Operacional (server-only, sin UI) ===
POLLAR_OPS_SECRET_KEY=sec_testnet_ops_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Stellar — plataforma/treasury (multi-sig 2-de-2 firmante) ===
PLATFORM_PUBLIC_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PLATFORM_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# === Cifrado árbitro + HMAC cookies (HKDF-SHA256 en lib/crypto.ts §6.4) ===
# Generar con: openssl rand -hex 32
APP_SECRET_KEY=

# === Neon Postgres — mismo string en dev y prod ===
# Pooler connection string (puerto 5432 con sslmode=require).
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.us-east-1.aws.neon.tech/pumatrade?sslmode=require

# === App ===
NEXT_PUBLIC_PLATFORM_FEE_BPS=200
# Demo: 3 min; producción: omitir (default 2880 min = 48h)
DEMO_TTL_MINUTES=3
# Demo: 10 min; producción: 480 min = 8h (PRD §4)
CONFIRM_WINDOW_MINUTES=10
HACKATHON_FREE_FEES=true
ENABLE_CRON=true
# Admin(es) que ven la cola de disputas (separar con coma para varios)
ADMIN_EMAILS=maria.pumatrade+seed1@mail.tm

# === Deploy (Vercel) ===
# Generar con: openssl rand -hex 16
CRON_SECRET=
# Solo prod (vacío en dev). Lo crea Vercel Blob automáticamente al activar storage.
BLOB_READ_WRITE_TOKEN=

# === Seed (opcional — sobreescribe IDs de wallets seed) ===
# JSON: {"usr_maria":"G...","usr_juan":"G...",...} — generado por npm run capture-wallets
SEED_WALLET_IDS={}

# === Dev ─────────────────────────────────────
# Si true y NODE_ENV !== 'production', habilita /api/auth/dev-login (cookie firmada).
# En Vercel debe estar UNDEFINED o "".
# DEV_LOGIN_ENABLED=true
# Gating de reset-demo: en prod requiere CRON_SECRET + esta flag.
ALLOW_RESET_DEMO=true
