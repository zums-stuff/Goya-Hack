# Issuer del USDC de demo en Stellar TESTNET.
# Generar una vez con: node -e "const {Keypair}=require('@stellar/stellar-sdk');const k=Keypair.random();console.log(k.publicKey());console.log(k.secret())"
# y fondear el issuer con friendbot: curl "https://friendbot.stellar.org?addr=<PUBLIC>"
DEMO_USDC_ISSUER_SECRET=

# Opcional: Pollar (sponsor del hackathon) — publishable key de dashboard.pollar.xyz
NEXT_PUBLIC_POLLAR_KEY=

# Directorio de datos SQLite
DATA_DIR=./data
